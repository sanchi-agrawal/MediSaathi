      }
    ],
    "banner": "FICTIONAL DEMO — NOT FOR MEDICAL USE",
    "randomness": "none"
  },
  "ground_truth_fields": [
    "raw_text",
    "name",
    "salt",
    "strength",
    "form",
    "frequency_pattern",
    "duration_days",
    "timing"
  ],
